{
  "name": "joysearch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check:release": "node scripts/release-check.ts",
    "evaluate:search": "node --env-file-if-exists=.env.local scripts/evaluate-search.ts",
    "evaluate:answers": "node --env-file-if-exists=.env.local scripts/evaluate-answers.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@neondatabase/serverless": "1.0.2",
    "ai": "^7.0.171",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
