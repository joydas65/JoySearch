# Server-only credentials. Copy to .env.local and enter your own keys locally.
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional model access for the answer evaluation; never expose to the browser.
AI_GATEWAY_API_KEY=
# At least 32 random bytes, encoded as hex; authenticates transient answer evidence.
ANSWER_CONTEXT_SECRET=

# Exa is the requested initial integration; the evaluation compares both providers.
SEARCH_PROVIDER=exa

# Hosted deployment only: production-scoped secrets and explicit enablement.
# Runtime role may execute budget functions only; never use the migration owner's URL.
BUDGET_DATABASE_URL=
JOYSEARCH_LIVE_ENABLED=false
JOYSEARCH_ORIGIN=https://joysearch.vercel.app
